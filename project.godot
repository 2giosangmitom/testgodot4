; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Đèn Đường Cuối Ngõ"
config/description="Streetlight at the Alley's End — PSX supernatural horror"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://autoload/default_bus_layout.tres"

[autoload]

InputSetup="*res://autoload/input_setup.gd"
EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
SaveSystem="*res://autoload/save_system.gd"
AudioDirector="*res://autoload/audio_director.gd"
Dialogue="*res://autoload/dialogue.gd"
RenderSettings="*res://autoload/render_settings.gd"
ChapterDirector="*res://autoload/chapter_director.gd"

[display]

window/size/viewport_width=864
window/size/viewport_height=486
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/theme.tres"

[internationalization]

locale/fallback="vi"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interactable"
3d_physics/layer_4="entity"
3d_physics/layer_5="trigger"
3d_physics/layer_6="pickup"

[rendering]

textures/canvas_textures/default_texture_filter=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
shading/overrides/force_vertex_shading=true
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[shader_globals]

psx_fog_color={
"type": "color",
"value": Color(0.04, 0.04, 0.05, 1)
}
psx_fog_near={
"type": "float",
"value": 6.0
}
psx_fog_far={
"type": "float",
"value": 10.0
}
psx_snap_resolution={
"type": "vec2",
"value": Vector2(320, 180)
}
psx_affine_strength={
"type": "float",
"value": 1.0
}
psx_static={
"type": "float",
"value": 0.0
}
psx_time_scale={
"type": "float",
"value": 1.0
}
